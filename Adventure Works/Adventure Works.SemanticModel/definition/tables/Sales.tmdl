table Sales
	lineageTag: 0b5bd1ba-1ea8-4558-af56-bd92bebf7e4e

	measure Revenue = SUMX(Sales,Sales[OrderQuantity]*RELATED(Products[ProductPrice]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Sales_KPI
		lineageTag: 862e965b-33d8-4840-b04d-2080f8b33d7b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Sold_Qty = SUM(Sales[OrderQuantity])
		formatString: 0.00
		displayFolder: Sales_KPI
		lineageTag: 78fb66b2-4bf1-4e5a-867f-464ec63d3659

	measure Total_Orders = DISTINCTCOUNT(Sales[OrderNumber])
		formatString: 0.00
		displayFolder: Sales_KPI
		lineageTag: 1c7fd2b2-037d-44dc-bdfa-d05cf1f2e9f7

	measure Bulk_Orders = CALCULATE([Total_Orders],Sales[OrderQuantity]>1)
		formatString: 0.00
		displayFolder: Sales_KPI
		lineageTag: d71d6f23-5a72-4b65-86cb-20f5e44af9fa

	measure High_Ticket = CALCULATE([Total_Orders],[Revenue]>AVERAGE(Products[ProductPrice]))
		displayFolder: Sales_KPI
		lineageTag: 97ba0fd5-600d-4b5a-b512-4f835ffeb16d

	measure Total_Cost = SUMX(Sales,Sales[OrderQuantity]*RELATED(Products[ProductCost]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Sales_KPI
		lineageTag: 5e38a15e-57ef-480a-88e8-e338b787b23f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Profit = [Revenue]-[Total_Cost]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Sales_KPI
		lineageTag: eb06fe44-cb73-4e17-bd79-23f66b948698

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Prev_Month_Orders = CALCULATE([Total_Orders],DATEADD(Sales[OrderDate],-1,MONTH))
		formatString: 0
		displayFolder: Sales_KPI
		lineageTag: 1b03c94c-892f-4285-b4c1-cf179f39c212

	measure Prev_Month_Revenue = CALCULATE([Revenue],DATEADD('Calendar'[Date],-1,MONTH))
		displayFolder: Sales_KPI
		lineageTag: e8d7a28a-2cae-4f95-8738-c75b5a41a9c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Target_Orders = [Prev_Month_Orders]*1.1
		displayFolder: Sales_KPI
		lineageTag: 3ba0bf4c-9a19-4281-aa7e-48a219485697

		annotation PBI_FormatHint = {"isGeneralNumber":true}

